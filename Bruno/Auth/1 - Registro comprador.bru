meta {
  name: Registro comprador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombre_usuario": "cliente_nuevo",
    "correo": "cliente_nuevo@correo.mx",
    "contrasena": "clave12345",
    "nombre": "Luis",
    "apellido_paterno": "García",
    "apellido_materno": "Martínez",
    "telefono": "5511223344"
  }
}

vars:pre-request {
  baseUrl:  http://localhost:8080
}
