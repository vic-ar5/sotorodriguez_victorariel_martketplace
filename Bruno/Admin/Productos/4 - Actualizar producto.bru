meta {
  name: Actualizar producto
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/admin/productos/{{idProducto}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "precio": 1499.00,
    "existencia": 15
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8080
  idProducto: 2
}
