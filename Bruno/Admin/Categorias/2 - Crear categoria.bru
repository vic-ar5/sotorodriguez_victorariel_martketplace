meta {
  name: Crear categoria
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/categorias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Mascotas",
    "descripcion": "Productos y accesorios para mascotas"
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8080
}
