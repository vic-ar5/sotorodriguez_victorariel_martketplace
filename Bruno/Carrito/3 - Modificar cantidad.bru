meta {
  name: Modificar cantidad
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/carrito/items/{{idProducto}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComprador}}
}

body:json {
  {
    "cantidad": 3
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8080
  idProducto: 10
}
